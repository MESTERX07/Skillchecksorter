<Window x:Class="SkillCheckSorter.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420" SizeToContent="Height"
        Background="#080808"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Same fixed ComboBox template -->
        <Style x:Key="DlgCombo" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground"  Value="#C0C0C0"/>
            <Setter Property="Background"  Value="#0F0F0F"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Width"       Value="90"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="TglBd"
                                                Background="{Binding Background,
                                                             RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush,
                                                             RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Fill="#909090"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TglBd" Property="BorderBrush" Value="#555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              VerticalAlignment="Center"
                                              Margin="10,0,22,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1"
                                        MaxHeight="180" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="4">
        <StackPanel Background="#080808" Margin="28,22,28,22">

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Settings"
                               FontSize="16" FontWeight="Bold" Foreground="#E8E8E8"/>
                    <TextBlock Text="Change folder configuration"
                               FontSize="11" Foreground="#888888" Margin="0,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="24" Height="24" FontSize="12" Cursor="Hand"
                        Background="Transparent" BorderBrush="Transparent"
                        Foreground="#909090"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A1010"/>
                                    <Setter Property="Foreground" Value="#FF6060"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="✕"/>
                </Button>
            </Grid>

            <!-- Fields -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Sort images from:" Width="155" FontSize="12"
                           Foreground="#909090" VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceCombo" Style="{StaticResource DlgCombo}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="HIT images go to:" Width="155" FontSize="12"
                           Foreground="#909090" VerticalAlignment="Center"/>
                <ComboBox x:Name="HitCombo" Style="{StaticResource DlgCombo}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="MISS images go to:" Width="155" FontSize="12"
                           Foreground="#909090" VerticalAlignment="Center"/>
                <ComboBox x:Name="MissCombo" Style="{StaticResource DlgCombo}"/>
            </StackPanel>

            <TextBlock x:Name="ConflictWarn"
                       Text="⚠  HIT and MISS folders must be different"
                       Foreground="#E05555" FontSize="11"
                       Margin="0,4,0,0" Visibility="Collapsed"/>

            <Border Height="1" Background="#141414" Margin="0,16,0,16"/>

            <Grid>
                <Button HorizontalAlignment="Left"
                        Width="90" Height="34" Content="Cancel"
                        FontSize="12" Cursor="Hand"
                        Background="#111111" Foreground="#A0A0A0" BorderBrush="#333333"
                        Template="{StaticResource FlatBtn}"
                        Click="CancelBtn_Click"/>
                <Button HorizontalAlignment="Right"
                        Width="90" Height="34" Content="Save"
                        FontSize="12" FontWeight="Bold" Cursor="Hand"
                        Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF"
                        Template="{StaticResource FlatBtn}"
                        Click="SaveBtn_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
