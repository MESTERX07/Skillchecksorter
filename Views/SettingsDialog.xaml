<Window x:Class="SkillCheckSorter.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460" SizeToContent="Height"
        Background="#080808"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DlgCombo" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground"  Value="#D0D0D0"/>
            <Setter Property="Background"  Value="#111111"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="Height"      Value="32"/>
            <Setter Property="Width"       Value="104"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="TglBd"
                                                Background="{Binding Background,
                                                             RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush,
                                                             RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,9,0"
                                                  Fill="#606060"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TglBd" Property="BorderBrush" Value="#484848"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TglBd" Property="BorderBrush" Value="#585858"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              VerticalAlignment="Center"
                                              Margin="11,0,24,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="200" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4"
                                                          Opacity="0.5" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
        </Style>
    </Window.Resources>

    <!-- Outer border with subtle shadow effect via margin trick -->
    <Border BorderBrush="#282828" BorderThickness="1" CornerRadius="8"
            Background="#0A0A0A">
        <StackPanel>

            <!-- ── Header ─────────────────────────────────────────────────── -->
            <Border Background="#080808" CornerRadius="8,8,0,0"
                    BorderBrush="#1C1C1C" BorderThickness="0,0,0,1"
                    Padding="22,18,18,18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Settings"
                                   FontSize="16" FontWeight="Bold" Foreground="#F0F0F0"/>
                        <TextBlock Text="Configure folder assignments"
                                   FontSize="11" Foreground="#505050" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="26" Height="26" FontSize="12" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="#606060"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3A1212"/>
                                        <Setter Property="Foreground" Value="#FF5555"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="✕"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Body ──────────────────────────────────────────────────── -->
            <StackPanel Margin="20,18,20,22">

                <!-- Folder assignment card -->
                <Border BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="6"
                        ClipToBounds="True">
                    <StackPanel>

                        <!-- Source row -->
                        <Border Background="#0D0D0D" Padding="14,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Source" FontSize="11" FontWeight="Bold"
                                               Foreground="#505050" Width="52" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sort images from" FontSize="12"
                                               Foreground="#909090" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="SourceCombo" Style="{StaticResource DlgCombo}"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#181818"/>

                        <!-- HIT row -->
                        <Border Background="#0A130A" Padding="14,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#162316" BorderBrush="#254025"
                                            BorderThickness="1" CornerRadius="3"
                                            Padding="7,2" Margin="0,0,11,0">
                                        <TextBlock Text="HIT" FontSize="10" FontWeight="Bold"
                                                   Foreground="#5ABF5A"/>
                                    </Border>
                                    <TextBlock Text="Sorted hits go to" FontSize="12"
                                               Foreground="#7A9A7A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="HitCombo" Style="{StaticResource DlgCombo}"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#181818"/>

                        <!-- MISS row -->
                        <Border Background="#130A0A" Padding="14,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#231616" BorderBrush="#402525"
                                            BorderThickness="1" CornerRadius="3"
                                            Padding="7,2" Margin="0,0,11,0">
                                        <TextBlock Text="MISS" FontSize="10" FontWeight="Bold"
                                                   Foreground="#E05555"/>
                                    </Border>
                                    <TextBlock Text="Sorted misses go to" FontSize="12"
                                               Foreground="#9A7A7A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="MissCombo" Style="{StaticResource DlgCombo}"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Conflict warning -->
                <Border x:Name="ConflictWarn"
                        Background="#1C0808" BorderBrush="#3A1818" BorderThickness="1"
                        CornerRadius="5" Padding="12,9"
                        Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="⚠  HIT and MISS folders must be different"
                               Foreground="#E05555" FontSize="11"/>
                </Border>

                <!-- Divider -->
                <Border Height="1" Background="#161616" Margin="0,18,0,16"/>

                <!-- Cancel + Save -->
                <Grid>
                    <Button HorizontalAlignment="Left"
                            Width="100" Height="36" Content="Cancel"
                            FontSize="12" Cursor="Hand"
                            Background="#111111" Foreground="#909090" BorderBrush="#2C2C2C"
                            Template="{StaticResource FlatBtn}"
                            Click="CancelBtn_Click"/>
                    <Button HorizontalAlignment="Right"
                            Width="100" Height="36" Content="Save"
                            FontSize="12" FontWeight="Bold" Cursor="Hand"
                            Background="#EEEEEE" Foreground="#0A0A0A" BorderBrush="#EEEEEE"
                            Template="{StaticResource FlatBtn}"
                            Click="SaveBtn_Click"/>
                </Grid>

                <!-- Uninstall section -->
                <Border Height="1" Background="#131313" Margin="0,20,0,16"/>

                <Grid VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Uninstall Application"
                                   FontSize="12" Foreground="#686868"/>
                        <TextBlock Text="Removes the app, settings and shortcuts"
                                   FontSize="10" Foreground="#383838" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Height="32" Padding="16,0" Content="Uninstall"
                            FontSize="11" Cursor="Hand"
                            Background="#180808" Foreground="#B04040" BorderBrush="#361010"
                            Template="{StaticResource FlatBtn}"
                            Click="UninstallBtn_Click"/>
                </Grid>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
